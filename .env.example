# Public website. Set these on the Vercel project and rebuild.
VITE_LEAD_DELIVERY=modernize
# Base URL of modernizeGateway, without /config or /submit. No publisher credentials here.
VITE_MODERNIZE_GATEWAY_URL=
# Keep unset until the private database, rules, backend, and real inbox are ready.
# This legacy endpoint is used for contractor interest and optional manual mode only.
VITE_PUBLIC_INTAKE_URL=
VITE_TURNSTILE_SITE_KEY=
# Optional. Manual address entry and ZIP lookup work without Google.
VITE_GOOGLE_MAPS_API_KEY=

# Existing contractor app configuration: retain the current project values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
